{
  // Static app only: there is no Worker script, so nothing runs on the server.
  "name": "card-to-use",
  "compatibility_date": "2026-11-01",
  // Serves the app on its own subdomain. Wrangler creates the DNS record and certificate
  // on deploy; kidiyoor.com must be a zone in the same Cloudflare account.
  "routes": [{ "pattern": "cards.kidiyoor.com", "custom_domain": true }],
  // Only reachable on the custom domain, so Cloudflare Access there cannot be bypassed.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
